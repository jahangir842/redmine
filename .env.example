# Copy to .env, replace every CHANGE_ME value, and keep that file private.
COMPOSE_PROJECT_NAME=redmine

# Published Nginx endpoint. Use 127.0.0.1 behind a host reverse proxy.
REDMINE_BIND_ADDRESS=127.0.0.1
REDMINE_HOST=redmine.example.internal
REDMINE_PORT=8080

# Dedicated, non-superuser application database and role.
REDMINE_DB_DATABASE=redmine
REDMINE_DB_USERNAME=redmine
REDMINE_DB_PASSWORD=CHANGE_ME_generate_a_long_random_password

# PostgreSQL bootstrap administrator. This is not used by Redmine.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_generate_a_different_long_random_password

# Generate with: openssl rand -hex 64
REDMINE_SECRET_KEY_BASE=CHANGE_ME_generate_with_openssl_rand_hex_64

# Local custom image name; keep stable for offline export/import.
REDMINE_IMAGE=local/redmine-dmsf:6.1.4-dmsf4.1.3

# Set true only in an explicitly disposable migration copy.
MIGRATION_MODE=false
